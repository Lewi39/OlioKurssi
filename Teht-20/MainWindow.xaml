<Window x:Class="Teht_20.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Teht_20"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <ListView x:Name="lbStudentList" Margin="10" />
            <Button x:Name="BtSaveToFile" Content="Tallena tiedot" Click="BtSaveFile_Click" Width="132" />
            <Button x:Name="BtLoadFromFile" Content="Lataa tiedot" Click="BtLoadFile_Click" Width="132" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Margin="10">Etunimi:</TextBlock>
                <TextBox x:Name="TbFirstName" Width="100" />
                <TextBlock Margin="10">Sukunimi:</TextBlock>
                <TextBox x:Name="TbLastName" Width="100" />
                <TextBlock Margin="10">OpiskelijaID:</TextBlock>
                <TextBox x:Name="TbId" Width="100" />
                <TextBlock Margin="10">Sähköposti:</TextBlock>
                <TextBox x:Name="TbEmail" Width="100" />
                <TextBlock Margin="10">Puhelinnumero:</TextBlock>
                <TextBox x:Name="TbPhoneNumber" Width="100" />
                <Button x:Name="BtAddStudent" Content="Lisää opiskelija" Click="BtAddStudent_Click" Width="100" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
