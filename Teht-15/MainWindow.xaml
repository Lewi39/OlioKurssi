<Window x:Class="Teht_15.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Teht_15"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button x:Name="BtnCar" Content="Car" HorizontalAlignment="Left" Margin="470,117,0,0" VerticalAlignment="Top" RenderTransformOrigin="2.113,0.559" Click="BtnCar_Click" Height="51" Width="52">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-0.769"/>
                    <TranslateTransform X="0.008" Y="-1.126"/>
                </TransformGroup>
            </Button.RenderTransform>
        </Button>
        <TextBlock x:Name="TbCar" HorizontalAlignment="Left" Margin="491,175,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="34" Width="14" Text="0"/>
        <Button x:Name="BtnTruck" Content="Truck" HorizontalAlignment="Center" Margin="0,115,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5" Click="BtnTruck_Click" Height="52" Width="52">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-0.769"/>
                    <TranslateTransform X="0" Y="0.001"/>
                </TransformGroup>
            </Button.RenderTransform>
        </Button>
        <TextBlock x:Name="TbTruck" HorizontalAlignment="Center" Margin="0,175,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="34" Width="16" Text="0"/>

    </Grid>
</Window>
