<Window x:Class="Teht__18.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Teht__18"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="350">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <TextBox x:Name="TbInput" Grid.Row="0" Grid.ColumnSpan="4" Margin="2" TextAlignment="Right" Text="0" FontSize="20" IsReadOnly="True"/>
        
        <Button x:Name="BtSeven" Content="7" Grid.Row="2" Grid.Column="0" FontSize="20" Margin="2" Click="BtNum_Click"/>
        
        <Button x:Name="BtEight" Content="8" Grid.Row="2" Grid.Column="1" FontSize="20" Margin="2" Click="BtNum_Click"/>
        
        <Button x:Name="BtNine" Content="9" Grid.Row="2" Grid.Column="2" FontSize="20" Margin="2" Click="BtNum_Click"/>
        
        <Button x:Name="BtFour" Content="4" Grid.Row="3" Grid.Column="0" FontSize="20" Margin="2" Click="BtNum_Click"/>
        
        <Button x:Name="BtFive" Content="5" Grid.Row="3" Grid.Column="1" FontSize="20" Margin="2" Click="BtNum_Click"/>
        
        <Button x:Name="BtSix" Content="6" Grid.Row="3" Grid.Column="2" FontSize="20" Margin="2" Click="BtNum_Click"/>
        
        <Button x:Name="BtOne" Content="1" Grid.Row="4" Grid.Column="0" FontSize="20" Margin="2" Click="BtNum_Click"/>
        
        <Button x:Name="BtTwo" Content="2" Grid.Row="4" Grid.Column="1" FontSize="20" Margin="2" Click="BtNum_Click"/>
        
        <Button x:Name="BtThree" Content="3" Grid.Row="4" Grid.Column="2" FontSize="20" Margin="2" Click="BtNum_Click"/>
        
        <Button x:Name="BtZero" Content="0" Grid.Row="5" Grid.Column="0" FontSize="20" Margin="2" Click="BtNum_Click"/>
        
        <Button x:Name="BtDot" Content="." Grid.Row="5" Grid.Column="1" FontSize="20" Margin="2" Click="BtDot_Click"/>
        
        <Button x:Name="BtSlash" Content="/" Grid.Row="1" Grid.Column="3" FontSize="20" Margin="2" Click="BtSlash_Click"/>
        
        <Button x:Name="BtTimes" Content="*" Grid.Row="2" Grid.Column="3" FontSize="20" Margin="2" Click="BtTimes_Click"/>
        
        <Button x:Name="BtPlus" Content="+" Grid.Row="3" Grid.Column="4" FontSize="20" Margin="2" Click="BtPlus_Click"/>
        
        <Button x:Name="BtMinus" Content="-" Grid.Row="4" Grid.Column="3" FontSize="20" Margin="2" Click="BtMinus_Click"/>   
        
        <Button x:Name="BtEqual" Content="=" Grid.Row="5" Grid.Column="2" FontSize="20" Margin="2" Grid.ColumnSpan="2" Click="btEquals_Click"/>
        
        <Button x:Name="BtBack" Content="←" Grid.Row="1" Grid.Column="0" FontSize="20" Margin="2" Grid.ColumnSpan="2" Click="BtBack_Click"/>
        
        <Button x:Name="BtClearAll" Content="C" Grid.Row="1" Grid.Column="2" FontSize="20" Margin="2" Click="BtClearAll_Click"/>
    </Grid>
</Window>
