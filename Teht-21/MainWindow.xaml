            x:Name="ListView" 
            HorizontalAlignment="Left"
            Height="200"
            VerticalAlignment="Top"
            Margin="5"
            Width="200">
            <ListView.View>
                <GridView>
                    <GridViewColumn/>
                </GridView>
            </ListView.View>
        </ListView>
    </Menu>
</Window>
