        <RadioButton Content="Shampoo" Checked="RadioButton_Checked"/>
        <RadioButton Content="Saippua" Checked="RadioButton_Checked"/>
        <RadioButton Content="Pasta" Checked="RadioButton_Checked"/>
        <RadioButton Content="Tomaatti murska" Checked="RadioButton_Checked"/>
        <RadioButton Content="Voi" Checked="RadioButton_Checked"/>
